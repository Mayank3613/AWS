{
  "name": "customer-report-system-aws",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "cd client && npm install && npm run build && cd ..",
    "install:all": "npm install && cd client && npm install && cd ..",
    "seed": "node seed.js"
  },
  "keywords": [
    "aws",
    "ec2",
    "rds",
    "postgresql",
    "mysql",
    "sequelize",
    "mern",
    "nginx",
    "pm2",
    "customer-report"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "Customer Report & Insight System configured for AWS EC2 & Amazon RDS PostgreSQL/MySQL Deployment",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
