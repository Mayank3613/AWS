# =================================================================
# Customer Report System - Environment Variables (.env.example)
# Amazon AWS EC2 + Amazon AWS RDS (PostgreSQL / MySQL)
# =================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# =================================================================
# Amazon AWS RDS Configuration
# =================================================================
# Set DB_HOST to your Amazon RDS Endpoint, e.g. customer-report-db.xxxxxx.us-east-1.rds.amazonaws.com
DB_HOST=customer-report-db.c7yxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=customer_report_system
DB_USER=postgres
DB_PASSWORD=YourSecureRDSPassword123!
DB_DIALECT=postgres
DB_SSL=true

# JWT Authentication Secret Key
JWT_SECRET=super_secret_jwt_key_aws_customer_report_2026_change_this

# CORS Configuration
# Set to '*' or comma-separated origins, e.g. http://<YOUR_EC2_PUBLIC_IP>,http://localhost:3000
CORS_ORIGIN=*

# Allow Express to serve static build if Nginx is not used (true/false)
SERVE_STATIC=false

# SMTP Mail Settings (Optional - for Email alerts and password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@customer-report.com
FROM_NAME="Customer Report System"
